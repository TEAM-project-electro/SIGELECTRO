APP_NAME="SIG Electrocentro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Conexión predeterminada de Laravel para ejecución web (solo lectura: sig_lector)
DB_CONNECTION=lector
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=seguimiento_gd
DB_USERNAME=sig_migrador
DB_PASSWORD=

# Cuentas técnicas de ejecución (Decisión 5)
DB_AUTH_USERNAME=sig_auth
DB_AUTH_PASSWORD=

DB_LECTOR_USERNAME=sig_lector
DB_LECTOR_PASSWORD=

DB_ESCRITOR_USERNAME=sig_escritor
DB_ESCRITOR_PASSWORD=

DW_DB_DATABASE=dw_seguimiento_gd
DW_DB_USERNAME=sig_etl
DW_DB_PASSWORD=
DW_BI_USERNAME=bi_lector
DW_BI_PASSWORD=

DB_DATABASE_TEST=seguimiento_gd_test
DW_DB_DATABASE_TEST=dw_seguimiento_gd_test

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=sig_electrocentro_

MAIL_MAILER=log
