        <bpmndi:BPMNLabel>
          <dc:Bounds x="845.0" y="385.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Avisar_di" bpmnElement="P08_Avisar">
