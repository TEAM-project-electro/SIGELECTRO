        <dc:Bounds x="510.0" y="445.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Leer_di" bpmnElement="P08_Leer">
        <dc:Bounds x="715.0" y="445.0" width="150" height="70"/>
