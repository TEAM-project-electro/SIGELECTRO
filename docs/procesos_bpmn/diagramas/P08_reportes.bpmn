      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Merge_di" bpmnElement="P08_Merge" isMarkerVisible="true">
        <dc:Bounds x="1380.0" y="455.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1255.0" y="385.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Tipo_di" bpmnElement="P08_Tipo" isMarkerVisible="true">
        <dc:Bounds x="1585.0" y="455.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1460.0" y="385.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_CSV_di" bpmnElement="P08_CSV">
        <dc:Bounds x="1740.0" y="445.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Imprimir_di" bpmnElement="P08_Imprimir">
        <dc:Bounds x="1740.0" y="535.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Merge2_di" bpmnElement="P08_Merge2" isMarkerVisible="true">
        <dc:Bounds x="1995.0" y="455.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1870.0" y="385.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Recibir_di" bpmnElement="P08_Recibir">
        <dc:Bounds x="2150.0" y="185.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_Fin_di" bpmnElement="P08_Fin">
        <dc:Bounds x="2412.0" y="202.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2355.0" y="245.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P08_Edge1" bpmnElement="P08_Flow1">
        <di:waypoint x="193.0" y="220.0"/>
        <di:waypoint x="305.0" y="220.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge2" bpmnElement="P08_Flow2">
        <di:waypoint x="455.0" y="220.0"/>
        <di:waypoint x="482.5" y="220.0"/>
        <di:waypoint x="482.5" y="480.0"/>
        <di:waypoint x="510.0" y="480.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge3" bpmnElement="P08_Flow3">
        <di:waypoint x="660.0" y="480.0"/>
        <di:waypoint x="715.0" y="480.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge4" bpmnElement="P08_Flow4">
        <di:waypoint x="865.0" y="480.0"/>
        <di:waypoint x="970.0" y="480.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge5" bpmnElement="P08_Flow5">
        <di:waypoint x="995.0" y="455.0"/>
        <di:waypoint x="995.0" y="385"/>
        <di:waypoint x="1405.0" y="385"/>
        <di:waypoint x="1405.0" y="455.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960.0" y="399.0" width="95" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge6" bpmnElement="P08_Flow6">
