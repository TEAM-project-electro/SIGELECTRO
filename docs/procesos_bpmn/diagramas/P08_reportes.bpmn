        <di:waypoint x="1327.5" y="480.0"/>
        <di:waypoint x="1380.0" y="480.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge8" bpmnElement="P08_Flow8">
        <di:waypoint x="1430.0" y="480.0"/>
        <di:waypoint x="1585.0" y="480.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge9" bpmnElement="P08_Flow9">
        <di:waypoint x="1635.0" y="480.0"/>
        <di:waypoint x="1740.0" y="480.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1652.5" y="459.0" width="95" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_Edge10" bpmnElement="P08_Flow10">
