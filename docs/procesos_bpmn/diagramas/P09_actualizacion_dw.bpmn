<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="P09_Definitions" targetNamespace="urn:academico:sig-electrocentro:procesos" exporter="SIG Electrocentro — documentación académica" exporterVersion="1.0">
  <bpmn:process id="P09_Process" name="Actualizar el almacén de datos — ETL" isExecutable="false">
    <bpmn:documentation>Carga manual desde la aplicación o comando local etl:cargar. Mantiene mutex y transacción para publicar dimensiones, hechos y revisión. No modela trabajo en Power BI ni una programación periódica no implementada.
Fuentes del sistema: sistema/app/Http/Controllers/EtlController.php, sistema/app/Services/EtlService.php, sistema/database/migrations/2026_11_03_000004_create_dw_procedimientos_y_vistas.php
Modelo descriptivo AS-IS: no incluye aprobaciones institucionales ni automatización de Bonita. Sesión activa requerida salvo P01 y operación técnica local P13.</bpmn:documentation>
    <bpmn:laneSet id="P09_LaneSet">
      <bpmn:lane id="P09_Lane0" name="Administrador">
        <bpmn:flowNodeRef>P09_I</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Pedir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P09_Lane1" name="Sistema SIG">
        <bpmn:flowNodeRef>P09_Perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Disponible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Ocupado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Origen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Dims</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Hechos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Liberar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Autorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_Denegado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P09_I" name="DW requiere actualización">
      <bpmn:outgoing>P09_Flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P09_Pedir" name="Solicitar ejecución ETL">
      <bpmn:incoming>P09_Flow1</bpmn:incoming>
      <bpmn:outgoing>P09_Flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P09_Perfil" name="Verificar Administrador">
      <bpmn:incoming>P09_Flow2</bpmn:incoming>
      <bpmn:outgoing>P09_Flow3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_Lock" name="Intentar adquirir mutex ETL">
      <bpmn:incoming>P09_Flow16</bpmn:incoming>
      <bpmn:outgoing>P09_Flow4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P09_Disponible" name="¿Mutex adquirido?" gatewayDirection="Diverging" default="P09_Flow6">
      <bpmn:incoming>P09_Flow4</bpmn:incoming>
      <bpmn:outgoing>P09_Flow5</bpmn:outgoing>
      <bpmn:outgoing>P09_Flow6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P09_Ocupado" name="Carga no iniciada">
      <bpmn:documentation>Si no se obtiene mutex dentro del tiempo configurado, devolver fallo sin modificar dimensiones/hechos. Una solicitud sin permiso termina denegada antes de ejecutar el procedimiento.</bpmn:documentation>
      <bpmn:incoming>P09_Flow6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P09_Origen" name="Iniciar transacción y bloquear revisión">
      <bpmn:incoming>P09_Flow5</bpmn:incoming>
      <bpmn:outgoing>P09_Flow7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_Dims" name="Sincronizar calendario y dimensiones">
      <bpmn:incoming>P09_Flow7</bpmn:incoming>
      <bpmn:outgoing>P09_Flow8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_Hechos" name="Cargar hechos y depurar ausentes">
      <bpmn:incoming>P09_Flow8</bpmn:incoming>
      <bpmn:outgoing>P09_Flow9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P09_Ok" name="¿Carga completa sin error?" gatewayDirection="Diverging" default="P09_Flow11">
      <bpmn:documentation>Abstracción del EXIT HANDLER SQL: cualquier excepción en la fase transaccional, incluso en calendario/dimensiones, recorre rollback; no se presupone que siempre se alcance la última inserción.</bpmn:documentation>
      <bpmn:incoming>P09_Flow9</bpmn:incoming>
      <bpmn:outgoing>P09_Flow10</bpmn:outgoing>
      <bpmn:outgoing>P09_Flow11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P09_Rollback" name="Revertir y registrar fallo">
      <bpmn:incoming>P09_Flow11</bpmn:incoming>
      <bpmn:outgoing>P09_Flow13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_Commit" name="Publicar datos y revisión en COMMIT">
      <bpmn:incoming>P09_Flow10</bpmn:incoming>
      <bpmn:outgoing>P09_Flow12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P09_Merge" name="Finalizar ejecución" gatewayDirection="Converging">
      <bpmn:incoming>P09_Flow12</bpmn:incoming>
      <bpmn:incoming>P09_Flow13</bpmn:incoming>
      <bpmn:outgoing>P09_Flow14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P09_Liberar" name="Liberar mutex e informar resultado">
      <bpmn:incoming>P09_Flow14</bpmn:incoming>
      <bpmn:outgoing>P09_Flow15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P09_Fin" name="Estado de carga informado">
      <bpmn:incoming>P09_Flow15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P09_Autorizado" name="¿Perfil autorizado?" gatewayDirection="Diverging" default="P09_Flow17">
      <bpmn:incoming>P09_Flow3</bpmn:incoming>
      <bpmn:outgoing>P09_Flow16</bpmn:outgoing>
      <bpmn:outgoing>P09_Flow17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P09_Denegado" name="Ejecución denegada">
      <bpmn:incoming>P09_Flow17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P09_Flow1" sourceRef="P09_I" targetRef="P09_Pedir"/>
    <bpmn:sequenceFlow id="P09_Flow2" sourceRef="P09_Pedir" targetRef="P09_Perfil"/>
    <bpmn:sequenceFlow id="P09_Flow3" sourceRef="P09_Perfil" targetRef="P09_Autorizado"/>
    <bpmn:sequenceFlow id="P09_Flow4" sourceRef="P09_Lock" targetRef="P09_Disponible"/>
    <bpmn:sequenceFlow id="P09_Flow5" sourceRef="P09_Disponible" targetRef="P09_Origen" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mutex_adquirido == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P09_Flow6" sourceRef="P09_Disponible" targetRef="P09_Ocupado" name="No"/>
    <bpmn:sequenceFlow id="P09_Flow7" sourceRef="P09_Origen" targetRef="P09_Dims"/>
    <bpmn:sequenceFlow id="P09_Flow8" sourceRef="P09_Dims" targetRef="P09_Hechos"/>
    <bpmn:sequenceFlow id="P09_Flow9" sourceRef="P09_Hechos" targetRef="P09_Ok"/>
    <bpmn:sequenceFlow id="P09_Flow10" sourceRef="P09_Ok" targetRef="P09_Commit" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">carga_sin_error == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P09_Flow11" sourceRef="P09_Ok" targetRef="P09_Rollback" name="No"/>
    <bpmn:sequenceFlow id="P09_Flow12" sourceRef="P09_Commit" targetRef="P09_Merge"/>
    <bpmn:sequenceFlow id="P09_Flow13" sourceRef="P09_Rollback" targetRef="P09_Merge"/>
    <bpmn:sequenceFlow id="P09_Flow14" sourceRef="P09_Merge" targetRef="P09_Liberar"/>
    <bpmn:sequenceFlow id="P09_Flow15" sourceRef="P09_Liberar" targetRef="P09_Fin"/>
    <bpmn:sequenceFlow id="P09_Flow16" sourceRef="P09_Autorizado" targetRef="P09_Lock" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">perfil == "Administrador"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P09_Flow17" sourceRef="P09_Autorizado" targetRef="P09_Denegado" name="No"/>
  </bpmn:process>
  <bpmn:collaboration id="P09_Collaboration">
    <bpmn:participant id="P09_Pool" name="SIG Electrocentro — P09" processRef="P09_Process"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="P09_Diagram" name="Actualizar el almacén de datos — ETL">
