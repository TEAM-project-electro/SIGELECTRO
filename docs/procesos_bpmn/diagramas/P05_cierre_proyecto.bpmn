          <dc:Bounds x="1050.0" y="385.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Observar_di" bpmnElement="P05_Observar">
        <dc:Bounds x="1330.0" y="535.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Atender_di" bpmnElement="P05_Atender">
        <dc:Bounds x="1330.0" y="275.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Guardar_di" bpmnElement="P05_Guardar">
        <dc:Bounds x="1330.0" y="445.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Fin_di" bpmnElement="P05_Fin">
        <dc:Bounds x="1592.0" y="202.0" width="36" height="36"/>
