        <dc:Bounds x="305.0" y="185.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Validar_di" bpmnElement="P05_Validar">
        <dc:Bounds x="510.0" y="445.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Permiso_di" bpmnElement="P05_Permiso" isMarkerVisible="true">
        <dc:Bounds x="765.0" y="455.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640.0" y="385.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Denegado_di" bpmnElement="P05_Denegado">
        <dc:Bounds x="977.0" y="552.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="920.0" y="595.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_LB_di" bpmnElement="P05_LB">
        <dc:Bounds x="920.0" y="445.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05_Completo_di" bpmnElement="P05_Completo" isMarkerVisible="true">
        <dc:Bounds x="1175.0" y="455.0" width="50" height="50"/>
