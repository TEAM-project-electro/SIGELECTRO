      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_Corregir_di" bpmnElement="P11_Corregir">
        <dc:Bounds x="920.0" y="275.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_Guardar_di" bpmnElement="P11_Guardar">
