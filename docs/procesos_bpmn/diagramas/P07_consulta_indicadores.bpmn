        <di:waypoint x="1330.0" y="480.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P07_Edge9" bpmnElement="P07_Flow9">
        <di:waypoint x="1480.0" y="480.0"/>
        <di:waypoint x="1535.0" y="480.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P07_Edge10" bpmnElement="P07_Flow10">
        <di:waypoint x="1685.0" y="480.0"/>
        <di:waypoint x="1712.5" y="480.0"/>
        <di:waypoint x="1712.5" y="220.0"/>
        <di:waypoint x="1740.0" y="220.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P07_Edge11" bpmnElement="P07_Flow11">
        <di:waypoint x="1890.0" y="220.0"/>
        <di:waypoint x="1995.0" y="220.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P07_Edge12" bpmnElement="P07_Flow12">
        <di:waypoint x="1995.0" y="220.0"/>
        <di:waypoint x="1970.0" y="220.0"/>
        <di:waypoint x="1970.0" y="112"/>
        <di:waypoint x="380.0" y="112"/>
        <di:waypoint x="380.0" y="185.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1947.5" y="199.0" width="95" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P07_Edge13" bpmnElement="P07_Flow13">
