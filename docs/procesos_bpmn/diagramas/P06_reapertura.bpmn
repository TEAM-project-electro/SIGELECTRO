          <dc:Bounds x="1050.0" y="385.0" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P06_Fallo_di" bpmnElement="P06_Fallo">
