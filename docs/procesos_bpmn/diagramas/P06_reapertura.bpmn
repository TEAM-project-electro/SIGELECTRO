        <dc:Bounds x="510.0" y="445.0" width="150" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P06_Valido_di" bpmnElement="P06_Valido" isMarkerVisible="true">
        <dc:Bounds x="765.0" y="455.0" width="50" height="50"/>
